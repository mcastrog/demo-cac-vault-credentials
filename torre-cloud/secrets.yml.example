---
# Secretos de la torre Cloud — se cifran con el vault-id "cloud".
#
#   cp torre-cloud/secrets.yml.example torre-cloud/secrets.yml
#   ansible-vault encrypt --vault-id cloud@prompt torre-cloud/secrets.yml
#
# Lo mantiene el equipo Cloud con SU vault password. No necesita la master.
#
#   ansible-vault edit --vault-id cloud@prompt torre-cloud/secrets.yml

# --- AWS --------------------------------------------------------------------
vault_aws_access_key: "CAMBIAME"
vault_aws_secret_key: "CAMBIAME"

# --- Azure ------------------------------------------------------------------
vault_azure_client_id: "CAMBIAME"
vault_azure_secret: "CAMBIAME"
vault_azure_subscription_id: "CAMBIAME"
vault_azure_tenant: "CAMBIAME"

# --- VMware -----------------------------------------------------------------
vault_vcenter_password: "CAMBIAME"
