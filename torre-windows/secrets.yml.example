---
# Secretos de la torre Windows — se cifran con el vault-id "windows".
#
#   cp torre-windows/secrets.yml.example torre-windows/secrets.yml
#   ansible-vault encrypt --vault-id windows@prompt torre-windows/secrets.yml
#
# Lo mantiene el equipo Windows con SU vault password. No necesita la master.
#
#   ansible-vault edit --vault-id windows@prompt torre-windows/secrets.yml

vault_windows_prod_password: "CAMBIAME"
vault_windows_pre_password: "CAMBIAME"
