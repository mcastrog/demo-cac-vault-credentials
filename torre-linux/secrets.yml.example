---
# Secretos de la torre Linux — se cifran con el vault-id "linux".
#
#   cp torre-linux/secrets.yml.example torre-linux/secrets.yml
#   ansible-vault encrypt --vault-id linux@prompt torre-linux/secrets.yml
#
# Lo mantiene el equipo Linux con SU vault password. No necesita la master.
# Para añadir o rotar un valor, sin descifrar el fichero entero:
#
#   ansible-vault edit --vault-id linux@prompt torre-linux/secrets.yml
#
# Cada variable de aquí se referencia desde torre-linux/credentials.yml,
# que va en claro y sí es revisable en un pull request.

vault_linux_prod_password: "CAMBIAME"
vault_linux_pre_password: "CAMBIAME"
vault_oracle_db_password: "CAMBIAME"
