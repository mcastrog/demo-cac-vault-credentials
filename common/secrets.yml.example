---
# Secretos comunes — se cifran con el vault-id "master".
#
#   cp common/secrets.yml.example common/secrets.yml
#   # rellenar los valores
#   ansible-vault encrypt --vault-id master@prompt common/secrets.yml
#
# Este fichero (.example) se queda en Git como referencia; el secrets.yml
# real se versiona SIEMPRE cifrado.

# --- Conexión al controller de AAP -----------------------------------------
# Cuenta usada por el JT de bootstrap y por el JT de configuración común.
vault_controller_hostname: "https://CAMBIAME.apps.ejemplo.com"
vault_controller_username: "admin"
vault_controller_password: "CAMBIAME"

# --- Vault passwords --------------------------------------------------------
# Una por torre. El administrador entrega a cada equipo SOLO la suya.
# La master no va aquí: se teclea al cifrar y se guarda solo en AAP.
vault_linux_vault_password: "CAMBIAME"
vault_windows_vault_password: "CAMBIAME"
vault_cloud_vault_password: "CAMBIAME"

# --- Integraciones ----------------------------------------------------------
# Token con permiso para registrar el webhook del repositorio. Opcional:
# el webhook también se puede dar de alta a mano desde la UI de GitHub.
vault_github_token: "CAMBIAME"
